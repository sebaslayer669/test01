{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run sync:public",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{fixtures/**,modulo/**,agent/**,src/**,node_modules/pdfkit/**,node_modules/fontkit/**,node_modules/linebreak/**,node_modules/unicode-properties/**,node_modules/png-js/**}"
    },
    "api/health.ts": {
      "includeFiles": "{fixtures/**,modulo/**,agent/**,src/**}"
    },
    "api/sessions/[id].ts": {
      "includeFiles": "{fixtures/**,modulo/**,agent/**,src/**}"
    }
  }
}
