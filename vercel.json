{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "api/health.mjs": {
      "includeFiles": "fixtures/**"
    },
    "api/chat.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "fixtures/**,dist/**"
    },
    "api/sessions/[id].mjs": {
      "includeFiles": "dist/**"
    }
  }
}
