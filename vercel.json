{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "functions": {
    "api/health.mjs": {
      "includeFiles": "fixtures/**"
    },
    "api/chat.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "fixtures/**,dist/**"
    },
    "api/sessions/[id].mjs": {
      "includeFiles": "dist/**"
    }
  }
}
