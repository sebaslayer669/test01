# Copiar a .env y completar. Nunca subir .env al repositorio.
# interno = sin tokens (recomendado en local/Vercel) | openai = API de OpenAI
LLM_PROVIDER=interno
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=3000
MAX_TOOL_ITERATIONS=25
MAX_TOKENS_PER_SESSION=80000
# Opcional: raíz de escritura (en Vercel se usa /tmp automáticamente)
# OUT_ROOT=/tmp/reto-01
